// Genshin Materials Domain
// Single schema with language field

model Material {
  id          Int      @id @default(autoincrement())
  lang        String   // 'en' or 'vn'
  name        String
  rarity      Int
  sortRank    Int?
  description String   @db.Text
  category    String
  typeText    String
  sources     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([lang, name])
  @@index([lang])
  @@index([lang, category])
  @@index([lang, rarity])
  @@map("materials")
  @@schema("genshin")
}
