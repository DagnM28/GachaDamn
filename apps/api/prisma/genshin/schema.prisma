// Genshin Database - Main Schema File
// Hỗ trợ multi-schema: en và vn

generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/@prisma/genshin-client"
}

datasource db {
  provider = "postgresql"
  url      = env("GENSHIN_DATABASE_URL")
  schemas  = ["en", "vn"] // Khai báo các schemas sẽ sử dụng
}
